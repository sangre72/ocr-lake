# 앱 환경변수 예제 (실제 값은 .env.local 에 — 커밋 금지)
DATABASE_URL="postgresql://<user>@localhost:5432/skyrecruit"
DATA_SOURCE=db
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# ★ 세션 안정화(필수): JWT 발급 서버 식별자(bid). 고정하지 않으면 —
#  - dev(Turbopack): 모듈 재평가 때 랜덤 UUID 가 갈려 auth() 가 세션을 null 처리 →
#    메뉴 클릭 중 무작위로 /login 튕김.
#  - 배포: 재배포·스케일아웃마다 전체 로그아웃.
# 반드시 고정 UUID 를 주입할 것(openssl rand -hex 16 또는 uuidgen).
SERVER_BOOT_ID="fixed-uuid-per-deployment"

# 개발 테스트 편의: 로그인 화면 데모 원클릭. 프로덕션 자동 비활성
# (서버 전용 — NEXT_PUBLIC_ 금지. ENABLE_DEMO_LOGIN=true && NODE_ENV!==production 일 때만 노출)
ENABLE_DEMO_LOGIN=true

# ★ PII 암호화(개인정보보호법) — 서버 전용, 폴백 금지, 프로덕션 필수(KMS/시크릿 주입).
#  PII_ENC_KEY  = 본문 AES-256-GCM 암호화 키 (a_207). 32바이트 = openssl rand -hex 32
#  PII_BLIND_KEY= blindIndex 동등검색 HMAC-SHA256 키 (a_20260807). 본문키와 분리(방어심층). 32바이트.
#  ★키 유실 = 복호 불가(영구손실) → 백업·접근감사 필수.
PII_ENC_KEY="generate-with-openssl-rand-hex-32"
PII_BLIND_KEY="generate-with-openssl-rand-hex-32-different-from-enc"
#
# ── 키 로테이션(2026-08-07) — 다중 키버전(kid) ──
#  암호문 포맷: 신 `v1:<kid>:iv:tag:cipher`(5파트) / 구 `v1:iv:tag:cipher`(4파트=k1, 하위호환).
#  PII_ENC_KEY = 기본키 k1(구4파트·kid=k1 복호). 로테이션 시:
#   1) 신키 발급 → PII_ENC_KEY_K2="openssl rand -hex 32"(구키와 다른 값).
#   2) PII_ENC_ACTIVE_KID=k2 로 올림 → 신규 저장은 k2, 구데이터는 각자 kid 로 계속 복호(무중단).
#   3) 여유 시 rewrap 스크립트(scripts/rewrap-pii.mjs)로 구kid → 활성kid 재암호(점진).
#  ★재암호 완료 전까지 구키(PII_ENC_KEY 등) 제거 금지 — 제거 시 그 kid 데이터 복호 불가.
#  ★blindIndex 키(PII_BLIND_KEY) 로테이션은 검색 인덱스 전면 재계산 필요 → 여기서 자동 안 함(수동·문서화).
PII_ENC_ACTIVE_KID="k1"
# PII_ENC_KEY_K2="generate-on-rotation-with-openssl-rand-hex-32"
#  키 공급자: env(기본, 위 env 키) | kms(Azure Key Vault 스텁 — 인프라 연동 후 사용).
PII_KEY_PROVIDER="env"

# -------------------------------------------------------------------------
# 소셜 로그인 (a_57·a_61) — 서버 전용. NEXT_PUBLIC_ 금지. 값 비우면 카카오 비활성.
# 카카오: https://developers.kakao.com/ — REST API 키=ID, Client Secret 활성화
# 로컬 콜백: http://localhost:3100/api/auth/callback/kakao
# 네이버: a_61 미사용 (AUTH_NAVER_* 설정해도 앱에서 로드하지 않음)
# -------------------------------------------------------------------------
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=
# AUTH_NAVER_ID=   # unused a_61
# AUTH_NAVER_SECRET= # unused a_61

# -------------------------------------------------------------------------
# 텔레그램 봇 (telegram_bot/) — 서버 전용, NEXT_PUBLIC_ 금지, 커밋 금지
# 토큰 발급: BotFather(@BotFather) → /newbot → 발급된 토큰을 채팅/로그에 남기지 말 것
# -------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="<botfather-issued-token>"
# 허용 채팅 ID(쉼표구분). 비우면 전체 허용 — 운영에서는 반드시 제한할 것
TELEGRAM_ALLOWED_CHAT_IDS=""
TELEGRAM_NEWS_CHECK_INTERVAL=3600
TELEGRAM_CONVERSATION_TIMEOUT=1800
TELEGRAM_MAX_CONCURRENT_JOBS=1

# -------------------------------------------------------------------------
# Discord 봇 (discord_bot/) — 서버 전용, 커밋 금지
# 토큰 발급: https://discord.com/developers/applications → New Application → Bot →
#   Reset Token(토큰 발급) → Privileged Gateway Intents 에서 "MESSAGE CONTENT INTENT" 활성화 필수
#   (첨부파일 읽기에 필요). 서버 초대: OAuth2 → URL Generator → bot 스코프 + Send Messages/
#   Read Message History/Attach Files 권한 체크 → 생성된 URL로 봇을 서버에 초대.
# -------------------------------------------------------------------------
DISCORD_BOT_TOKEN="<discord-developer-portal-issued-token>"
# 허용 채널 ID(쉼표구분). 비우면 전체 허용 — 운영에서는 반드시 제한할 것
DISCORD_ALLOWED_CHANNEL_IDS=""
DISCORD_OCR_LANG="kor+eng"
DISCORD_MAX_FILE_SIZE_MB=20


# -------------------------------------------------------------------------
# Slack 봇 (slack_bot/) — 서버 전용, 커밋 금지
# 토큰 발급: https://api.slack.com/apps → Create New App → OAuth & Permissions 에서
#   Bot Token Scopes(files:read, chat:write 등) 추가 → 워크스페이스에 설치 → Bot User OAuth Token(xoxb-...) 복사.
#   Signing Secret 은 Basic Information 페이지에서 확인. Event Subscriptions 에서 file_shared 이벤트 구독 필요
#   (HTTP 모드 — Request URL 로 이 서버의 공인 접속 주소가 필요. 로컬 개발 시 ngrok 등 터널 필요).
# -------------------------------------------------------------------------
SLACK_BOT_TOKEN="<xoxb-slack-bot-token>"
SLACK_SIGNING_SECRET="<slack-app-signing-secret>"
# 허용 채널 ID(쉼표구분). 비우면 전체 허용 — 운영에서는 반드시 제한할 것
SLACK_ALLOWED_CHANNEL_IDS=""
SLACK_OCR_LANG="kor+eng"
SLACK_MAX_FILE_SIZE_MB=20
# HTTP 모드로 Bolt 앱이 리스닝할 로컬 포트
SLACK_PORT=3010

# -------------------------------------------------------------------------
# 저장소(Storage Provider) — core/storage/base.py StorageProvider 구현 선택
# STORAGE_PROVIDER=sqlite(기본값, DB 파일 자동생성) | postgres(아래 접속정보 필요)
# -------------------------------------------------------------------------
STORAGE_PROVIDER=sqlite

# postgres 선택 시 필요. OCR_LAKE_DATABASE_URL 우선, 없으면 POSTGRES_* 개별 조합 사용.
# ★일반 DATABASE_URL 이 아닌 OCR_LAKE_DATABASE_URL 사용 — 이 파일 최상단의 DATABASE_URL 은
#   다른 프로젝트(skyrecruit)용이라, 혼동해 남의 DB에 연결하는 사고를 막기 위함.
# 이 프로젝트 전용 DB(예: ocr_lake)를 별도로 만들어 쓸 것 — 다른 프로젝트 DB와 공유 금지.
# 로컬 psql 로 사전 준비: createdb ocr_lake && psql -d ocr_lake -c "CREATE EXTENSION IF NOT EXISTS vector;"
# OCR_LAKE_DATABASE_URL="postgresql://<user>@localhost:5432/ocr_lake"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=ocr_lake
# pgvector 확장 활성화됨(CREATE EXTENSION vector) — ocr_records.embedding vector(768) 컬럼 준비.
# ★실제 임베딩 생성 모델 연동은 미구현(스켈레톤만) — docs/tech-spec.md §7 참고.

# 작업 큐 관리 대시보드(/admin, /api/admin/*) — design-guideline.md §7: system-internal 정보는
# 기본적으로 꺼둔다. 필요할 때만 명시적으로 켤 것(인증 시스템은 아직 없음 — 로컬/신뢰 환경에서만 사용).
ADMIN_DASHBOARD_ENABLED=""

# -------------------------------------------------------------------------
# 클라우드 OCR provider(core/ocr/providers/, §14-4)
# ★실구현(1개, REST API 직접 호출·SDK 미사용): Google Cloud Vision.
#   미설정 시 GoogleVisionNotConfiguredError 를 명확히 발생시킴(core/pipeline.py 는 계속 로컬
#   Tesseract만 사용 — 클라우드 폴백은 옵션이며 미설정이어도 기존 동작 회귀 없음).
# ★인터페이스만(자격증명 없음, 실 API 미연동): AWS Textract·Azure Document Intelligence·
#   Naver CLOVA OCR — 호출 시 각각 명확한 NotImplementedError 발생. SDK도 미설치.
# -------------------------------------------------------------------------
# GOOGLE_CLOUD_VISION_API_KEY=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
# AZURE_DOCUMENT_INTELLIGENCE_KEY=""
# NAVER_CLOVA_OCR_API_URL=""
# NAVER_CLOVA_OCR_SECRET_KEY=""
